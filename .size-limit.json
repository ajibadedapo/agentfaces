[
  {
    "name": "agentfaces (faceFor + renderFaceSvg)",
    "path": "dist/index.js",
    "import": "{ faceFor, renderFaceSvg }",
    "limit": "9 kB"
  },
  {
    "name": "agentfaces (everything)",
    "path": "dist/index.js",
    "import": "*",
    "limit": "20 kB"
  },
  {
    "name": "agentfaces/svg",
    "path": "dist/svg/index.js",
    "import": "{ renderFaceSvg, buildFaceSet }",
    "limit": "8 kB"
  },
  {
    "name": "agentfaces/react",
    "path": "dist/react/index.js",
    "import": "{ AgentFace }",
    "ignore": [
      "react",
      "react-dom"
    ],
    "limit": "21 kB"
  },
  {
    "name": "agentfaces/react-native",
    "path": "dist/react-native/index.js",
    "import": "{ AgentFace }",
    "ignore": [
      "react",
      "react-native",
      "react-native-svg"
    ],
    "limit": "21 kB"
  },
  {
    "name": "agentfaces/livekit (adapter only)",
    "path": "dist/livekit/index.js",
    "import": "*",
    "ignore": [
      "agentfaces"
    ],
    "limit": "1 kB"
  },
  {
    "name": "agentfaces/openai-realtime (adapter only)",
    "path": "dist/openai-realtime/index.js",
    "import": "*",
    "ignore": [
      "agentfaces"
    ],
    "limit": "1.5 kB"
  },
  {
    "name": "agentfaces/elevenlabs (adapter only)",
    "path": "dist/elevenlabs/index.js",
    "import": "*",
    "ignore": [
      "agentfaces"
    ],
    "limit": "1 kB"
  }
]

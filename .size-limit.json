    "import": "{ faceFor, renderFaceSvg }",
    "limit": "9 kB"
  },
  {
    "name": "agentfaces (everything)",
    "path": "dist/index.js",
    "import": "*",
    "limit": "18 kB"
  },
  {
    "name": "agentfaces/svg",
    "path": "dist/svg/index.js",

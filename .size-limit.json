      "react",
      "react-dom"
    ],
    "limit": "19 kB"
  },
  {
    "name": "agentfaces/react-native",
    "path": "dist/react-native/index.js",
    "import": "{ AgentFace }",
    "ignore": [
      "react",
      "react-native",
      "react-native-svg"
    ],
    "limit": "19 kB"
  }
]
